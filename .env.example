# Copy this file to ".env" in the same folder, then fill in the values.
# Do NOT share the .env file or zip it with real passwords in it.

# Email (needed for email sign-in codes and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=paste-16-character-app-password-here
SMTP_FROM=Vids CRM <your-email@example.com>

# Address of the CRM, used in reset links
APP_URL=http://localhost:3000

# Long random text used to sign login tokens (set this before real use)
JWT_SECRET=change-this-to-a-long-random-text

# Fixed administrator login. Optional. When ADMIN_PASSWORD is set, it becomes the admin
# password every time the server starts, so you never need reset-password.js.
# Change the password by editing this line and restarting the server.
# ADMIN_USERNAME=svapnil
# ADMIN_PASSWORD=paste-a-strong-password-at-least-8-characters

# Storage. Use sqlite for the live team (50+ users). Run migrate-json-to-sqlite.js once first.
# STORAGE=sqlite
